#!/bin/sh

#SBATCH --job-name=ds005559-mriqc
#SBATCH --mail-type=END
#SBATCH --mail-user=jbwexler@stanford.edu
#SBATCH --output=/scratch1/03201/jbwexler/openneuro_derivatives/derivatives/mriqc/ds005559-mriqc/.reproman/jobs/local/20250710-132815-c862/stdout
#SBATCH --error=/scratch1/03201/jbwexler/openneuro_derivatives/derivatives/mriqc/ds005559-mriqc/.reproman/jobs/local/20250710-132815-c862/stderr

#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --time=8:00:00
#SBATCH --partition=small

metadir=/scratch1/03201/jbwexler/openneuro_derivatives/derivatives/mriqc/ds005559-mriqc/.reproman/jobs/local/20250710-132815-c862

module load launcher
module load impi/19.0.5
module load remora
module load ooops
module load cdtools

set_io_param_batch $SLURM_JOBID 0 low
export LAUNCHER_JOB_FILE="$metadir/launcher"

job_name=ds005559-mriqc
software="${job_name#*-}"
work_dir_scratch="$SCRATCH/work_dir/$software/"

for task_id in $(seq 0 1); do
    printf "$metadir/runscript %d >$metadir/stdout.%d 2>$metadir/stderr.%d\n" \
      "$task_id" "$task_id" "$task_id" >>"$LAUNCHER_JOB_FILE"
done

# Symlink containers annex to node tmp
chmod -R 775 code/containers/.git/annex
rm -rf code/containers/.git/annex
ln -s /tmp/annexes/containers code/containers/.git/annex

# Use cdtools to copy containers to node tmp
distribute.bash ${STAGING}/annexes

wait

remora "$LAUNCHER_DIR"/paramrun